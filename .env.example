# ─────────────────────────────────────────────────────────────
#  Domaine Thibica · envoi des e-mails du formulaire de commande
#  Boîte OVH : info@thibica.com
#
#  1. Copiez ce fichier en .env.local et remplissez SMTP_PASS (développement local).
#  2. En production, ajoutez les mêmes variables sur Vercel (voir DEPLOIEMENT.md).
#  Ne mettez JAMAIS le vrai mot de passe dans ce fichier : il est versionné.
# ─────────────────────────────────────────────────────────────

# Serveur SMTP OVH
#   Offre MX Plan / e-mails inclus avec le domaine : ssl0.ovh.net, port 465
#   Offre Email Pro                                  : pro1.mail.ovh.net, port 587
#   Offre Exchange                                   : l'hôte indiqué dans l'espace client OVH (ex. ex5.mail.ovh.net), port 587
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465

# Identifiant = l'adresse complète, mot de passe = celui de la boîte mail OVH
SMTP_USER=info@thibica.com
SMTP_PASS=

# Expéditeur affiché (doit être l'adresse OVH ci-dessus, sinon OVH refuse l'envoi)
MAIL_FROM="Domaine Thibica <info@thibica.com>"

# Adresse qui reçoit les demandes de commande
MAIL_TO=info@thibica.com

# true = envoie aussi un accusé de réception au client
MAIL_SEND_CONFIRMATION=true
